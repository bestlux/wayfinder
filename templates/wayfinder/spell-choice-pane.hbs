<section class="selection-stage spell-selection-stage">
  <section class="option-browser">
    <div class="option-browser-scroll" data-step-id="{{activePane.stepId}}" data-wayfinder-scroll-id="{{activePane.stepId}}:options">
      <header class="browser-header">
        {{> "modules/wayfinder-pf2e/templates/wayfinder/picker-result-count.hbs"}}

        <label class="search-shell">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="search" value="{{activePane.search}}" placeholder="Search name, source, rarity…" aria-label="Search spells" data-wayfinder-search data-step-id="{{activePane.stepId}}" />
        </label>

        {{#if activePane.selectedSpells.length}}
          <section class="spell-selected-summary is-{{activePane.selectionState}}" aria-label="Selected spells" aria-invalid="{{#if activePane.excessCount}}true{{else}}false{{/if}}">
            <div class="spell-selected-summary-heading">
              <span>Selected</span>
              <span>{{activePane.selectedCount}} / {{activePane.requiredCount}}</span>
            </div>

            {{#if activePane.excessCount}}
              <p class="spell-selection-error">
                Remove {{activePane.excessCount}} extra spell{{#unless (eq activePane.excessCount 1)}}s{{/unless}} before Apply.
              </p>
            {{/if}}

            <div class="spell-selected-list" data-wayfinder-scroll-id="{{activePane.stepId}}:selected-spells">
              {{#each activePane.selectedSpells}}
                <button
                  type="button"
                  class="spell-selected-item"
                  data-wayfinder-action="toggle-spell-choice"
                  data-step-id="{{../activePane.stepId}}"
                  data-value="{{value}}"
                  aria-label="Remove {{name}}"
                  title="Remove {{name}}"
                >
                  <span class="spell-selected-name">{{name}}</span>
                  <span class="spell-selected-rank">{{rankLabel}}</span>
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              {{/each}}
            </div>
          </section>
        {{/if}}
      </header>

      <div class="spell-browser-notes">
        <p class="context-note">{{activePane.selectedCount}} / {{activePane.requiredCount}} chosen · {{activePane.destinationLabel}}</p>

        <div class="spell-source-note">
          <span>Source: {{activePane.sourceName}}</span>
          {{#if activePane.contextNote}}
            <span>{{activePane.contextNote}}</span>
          {{/if}}
        </div>

        {{#if activePane.rarityAccess.visible}}
          <section class="spell-rarity-access is-{{activePane.rarityAccess.state}}" aria-label="Restricted-spell player attestation">
            <div class="spell-rarity-access-heading">
              <strong>Player attestation</strong>
              {{#if (eq activePane.rarityAccess.state "unresolved")}}<span>Needs review</span>{{/if}}
              {{#if (eq activePane.rarityAccess.state "stale")}}<span>Stale</span>{{/if}}
              {{#if (eq activePane.rarityAccess.state "unused")}}<span>Not currently needed</span>{{/if}}
              {{#if (eq activePane.rarityAccess.state "attested")}}<span>Recorded</span>{{/if}}
            </div>

            {{#if activePane.rarityAccess.reason}}
              <dl class="spell-rarity-attestation-details">
                <div><dt>Claimed basis</dt><dd>{{activePane.rarityAccess.basisLabel}}</dd></div>
                <div><dt>Reason</dt><dd>{{activePane.rarityAccess.reason}}</dd></div>
                <div><dt>Recorded by</dt><dd>{{activePane.rarityAccess.authorName}}</dd></div>
                <div><dt>Recorded at</dt><dd><time datetime="{{activePane.rarityAccess.attestedAt}}">{{activePane.rarityAccess.attestedAt}}</time></dd></div>
              </dl>
            {{/if}}

            <p class="spell-rarity-attestation-disclaimer">
              This is a player claim, not verified GM authorization.
            </p>
            <button
              type="button"
              class="secondary{{#if activePane.rarityAccess.granted}} is-selected{{/if}}"
              data-wayfinder-action="toggle-spell-rarity-access"
              data-step-id="{{activePane.stepId}}"
              aria-describedby="{{activePane.rarityAccess.descriptionId}}"
              {{#if activePane.rarityAccess.locked}}disabled{{/if}}
            >
              {{#if (eq activePane.rarityAccess.state "attested")}}
                <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove player attestation
              {{else}}
                {{#if (eq activePane.rarityAccess.state "unused")}}
                  <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove unused attestation
                {{else}}
                  <i class="fa-solid fa-pen" aria-hidden="true"></i> Record player attestation
                {{/if}}
              {{/if}}
            </button>
            {{#if (eq activePane.rarityAccess.state "unresolved")}}
              <button
                type="button"
                class="secondary"
                data-wayfinder-action="remove-spell-rarity-attestation"
                data-step-id="{{activePane.stepId}}"
                aria-describedby="{{activePane.rarityAccess.descriptionId}}"
              >
                <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove migrated attestation
              </button>
            {{/if}}
            {{#if (eq activePane.rarityAccess.state "stale")}}
              <button
                type="button"
                class="secondary"
                data-wayfinder-action="remove-spell-rarity-attestation"
                data-step-id="{{activePane.stepId}}"
                aria-describedby="{{activePane.rarityAccess.descriptionId}}"
              >
                <i class="fa-solid fa-trash" aria-hidden="true"></i> Remove stale attestation
              </button>
            {{/if}}
            <p id="{{activePane.rarityAccess.descriptionId}}">
              Spells above the world's default rarity ceiling require character or rules Access, or permission reported by the player.
              {{#if activePane.rarityAccess.locked}}Clear this step's spells before removing the attestation.{{/if}}
            </p>
          </section>
        {{/if}}
      </div>

      {{> "modules/wayfinder-pf2e/templates/wayfinder/spell-choice-results.hbs"}}
    </div>
  </section>

  <section class="preview-pane">
    {{#if activePane.preview}}
      <header class="preview-banner">
        <img src="{{activePane.preview.img}}" alt="{{activePane.preview.title}}" />

        <div class="preview-heading">
          <h4>{{activePane.preview.title}}</h4>
          {{#if activePane.preview.source}}
            <p class="preview-source">{{activePane.preview.source}}</p>
          {{/if}}

          <ul class="preview-tags">
            {{#if activePane.preview.rarity}}
              <li class="tag rarity-{{activePane.preview.rarity}}">{{activePane.preview.rarity}}</li>
            {{/if}}
            {{#each activePane.preview.tags}}
              <li class="tag">{{this}}</li>
            {{/each}}
          </ul>
        </div>

        <div class="preview-actions">
          <button type="button" class="primary" data-wayfinder-action="toggle-spell-choice" data-step-id="{{activePane.stepId}}" data-value="{{activePane.preview.value}}">
            {{activePane.preview.selectedLabel}}
          </button>
          {{#if activePane.selectedValues.length}}
            <button type="button" class="secondary" data-wayfinder-action="clear-option" data-step-id="{{activePane.slotId}}">
              Clear
            </button>
          {{/if}}
        </div>
      </header>

      {{#if activePane.preview.details.length}}
        <dl class="detail-grid">
          {{#each activePane.preview.details}}
            <div class="detail-row">
              <dt>{{label}}</dt>
              <dd title="{{value}}">{{value}}</dd>
            </div>
          {{/each}}
        </dl>
      {{/if}}

      <section class="preview-description prose">
        {{{activePane.preview.description}}}
      </section>
    {{else}}
      {{#if activePane.infoState}}
        <div class="preview-empty picker-state picker-state-{{activePane.infoState.tone}}">
          <p class="eyebrow">{{activePane.infoState.eyebrow}}</p>
          <h4>{{activePane.infoState.title}}</h4>
          <p>{{activePane.infoState.message}}</p>
        </div>
      {{else}}
        <div class="preview-empty">
          <p>Pick a spell on the left to read about it, then add it to your draft.</p>
        </div>
      {{/if}}
    {{/if}}
  </section>
</section>

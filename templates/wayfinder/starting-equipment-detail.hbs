<aside class="equipment-detail{{#unless activePane.catalogue.preview}} is-empty{{/unless}}" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Detail.Aria"}}" {{#unless activePane.catalogue.preview}}aria-description="{{localize "wayfinder-pf2e.StartingEquipment.Detail.Empty"}}"{{/unless}} data-application-part="equipment-detail" data-step-id="{{activePane.stepId}}">
  {{#if activePane.catalogue.preview}}
    <p class="equipment-detail-summary" data-equipment-preview="{{activePane.catalogue.preview.sourceUuid}}">{{activePane.catalogue.preview.name}} · {{localize "wayfinder-pf2e.StartingEquipment.Detail.LevelRarity" level=activePane.catalogue.preview.level rarity=activePane.catalogue.preview.rarityLabel}} · {{localize "wayfinder-pf2e.StartingEquipment.Detail.Price"}}: {{activePane.catalogue.preview.priceLabel}} · {{localize "wayfinder-pf2e.StartingEquipment.Detail.Bulk"}}: {{activePane.catalogue.preview.bulkLabel}} · {{localize "wayfinder-pf2e.StartingEquipment.Detail.Hands"}}: {{activePane.catalogue.preview.handsLabel}} · {{localize "wayfinder-pf2e.StartingEquipment.Detail.Traits"}}: {{activePane.catalogue.preview.traits}}</p>
    {{#if activePane.catalogue.preview.canBuyWithCurrency}}<button type="button" class="primary compact" aria-label="{{activePane.catalogue.preview.buyAriaLabel}}" data-wayfinder-action="add-equipment-item" data-wayfinder-focus-id="{{activePane.catalogue.preview.buyFocusId}}" data-step-id="{{activePane.stepId}}" data-source-uuid="{{activePane.catalogue.preview.sourceUuid}}" data-funding="currency">{{localize "wayfinder-pf2e.StartingEquipment.Actions.BuyWithCoin"}}</button>{{/if}}
    {{#each activePane.catalogue.preview.allowanceOptions}}<button type="button" class="secondary compact" aria-label="{{ariaLabel}}" data-wayfinder-action="add-equipment-item" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-source-uuid="{{../activePane.catalogue.preview.sourceUuid}}" data-funding="allowance" data-allowance-id="{{allowanceId}}">{{label}}</button>{{/each}}
    {{#if activePane.catalogue.preview.canRequestException}}<button type="button" class="secondary compact" aria-label="{{activePane.catalogue.preview.requestExceptionAriaLabel}}" data-wayfinder-action="request-equipment-item-exception" data-wayfinder-focus-id="{{activePane.catalogue.preview.requestExceptionFocusId}}" data-step-id="{{activePane.stepId}}" data-source-uuid="{{activePane.catalogue.preview.sourceUuid}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.RequestException"}}</button>{{/if}}
    {{#if activePane.catalogue.preview.canApproveException}}<button type="button" class="secondary compact" aria-label="{{activePane.catalogue.preview.approveExceptionAriaLabel}}" data-wayfinder-action="approve-equipment-item-exception" data-wayfinder-focus-id="{{activePane.catalogue.preview.approveExceptionFocusId}}" data-step-id="{{activePane.stepId}}" data-source-uuid="{{activePane.catalogue.preview.sourceUuid}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.ApproveException"}}</button>{{/if}}
    {{#unless activePane.catalogue.preview.canAdd}}<button type="button" class="primary compact" aria-label="{{activePane.catalogue.preview.unavailableAriaLabel}}" disabled>{{localize "wayfinder-pf2e.StartingEquipment.Actions.Add"}}</button>{{/unless}}
    {{#if activePane.catalogue.preview.canChooseTitanMauler}}<button type="button" class="secondary compact" aria-label="{{activePane.catalogue.preview.titanMaulerAriaLabel}}" data-wayfinder-action="choose-titan-mauler-equipment" data-wayfinder-focus-id="{{activePane.catalogue.preview.titanMaulerFocusId}}" data-step-id="{{activePane.stepId}}" data-source-uuid="{{activePane.catalogue.preview.sourceUuid}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.ChooseTitanMauler"}}</button>{{/if}}
    {{#if activePane.catalogue.preview.unavailableReason}}<small class="equipment-unavailable">{{activePane.catalogue.preview.unavailableReason}}</small>{{else}}{{#unless activePane.catalogue.preview.canAdd}}<small class="equipment-unavailable">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.NoFunding"}}</small>{{/unless}}{{/if}}
  {{/if}}
</aside>

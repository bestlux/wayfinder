<div class="equipment-catalogue-projection" data-application-part="equipment-catalogue" data-step-id="{{activePane.stepId}}" data-wayfinder-rendered-query="{{activePane.catalogue.search}}" data-wayfinder-view-revision="{{equipmentRequest.viewRevision}}" data-wayfinder-source-revision="{{equipmentRequest.sourceRevision}}">
  <div class="equipment-filter-row" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.FiltersAria"}}" aria-controls="{{activePane.stepId}}-equipment-results">
    {{#each activePane.catalogue.typeFilters}}<button type="button" class="secondary compact{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}">{{label}}</button>{{/each}}
    {{#if activePane.catalogue.rarityFilters.length}}<button type="button" class="secondary compact{{#if activePane.catalogue.rarityFilterActive}} is-selected{{/if}}" aria-expanded="{{#if activePane.catalogue.rarityPanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-rarity-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:rarity" data-step-id="{{activePane.stepId}}" data-filter-key="rarity">{{activePane.catalogue.rarityFilterLabel}}</button>{{/if}}
    {{#if activePane.catalogue.hasSourceFilters}}<button type="button" class="secondary compact{{#if activePane.catalogue.sourceFilterActive}} is-selected{{/if}}" aria-expanded="{{#if activePane.catalogue.sourcePanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-source-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:source" data-step-id="{{activePane.stepId}}" data-filter-key="source">{{activePane.catalogue.sourceFilterLabel}}</button>{{/if}}
  </div>
  {{#if activePane.catalogue.rarityPanelOpen}}
    <div class="equipment-filter-panel" id="{{activePane.stepId}}-equipment-rarity-filters" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.RarityFiltersAria"}}">
      {{#each activePane.catalogue.rarityFilters}}<button type="button" class="secondary compact{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}">{{label}}</button>{{/each}}
    </div>
  {{/if}}
  {{#if activePane.catalogue.sourcePanelOpen}}
    <div class="equipment-source-filter-panel" id="{{activePane.stepId}}-equipment-source-filters">
      <input type="search" value="{{activePane.catalogue.sourceSearch}}" placeholder="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchPlaceholder"}}" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchAria"}}" aria-controls="{{activePane.stepId}}-equipment-source-options" data-wayfinder-equipment-source-search data-wayfinder-focus-id="starting-equipment-source-search" data-step-id="{{activePane.stepId}}" />
      <p role="status" aria-live="polite" aria-atomic="true">{{activePane.catalogue.sourceResultAnnouncement}}</p>
      <div id="{{activePane.stepId}}-equipment-source-options" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceFiltersAria"}}">
        {{#each activePane.catalogue.sourceFilters}}<button type="button" class="secondary compact{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}">{{label}}</button>{{/each}}
      </div>
    </div>
  {{/if}}
  <p class="equipment-result-count" role="status" aria-live="polite" aria-atomic="true">{{activePane.catalogue.resultAnnouncement}}</p>
  {{#unless activePane.catalogue.items.length}}
    <div class="equipment-catalogue-state {{activePane.catalogue.state}}" role="status" aria-live="polite" aria-atomic="true"><i class="fa-solid fa-box-open" aria-hidden="true"></i><p>{{activePane.catalogue.message}}</p>
      {{#if activePane.catalogue.diagnostics.length}}
        <ul class="equipment-source-diagnostics">
          {{#each activePane.catalogue.diagnostics}}<li data-equipment-source-diagnostic="{{code}}"><strong>{{packId}}</strong>: {{message}}</li>{{/each}}
        </ul>
      {{/if}}
    </div>
  {{/unless}}
  <div class="equipment-result-list" id="{{activePane.stepId}}-equipment-results" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-results">
    {{#each activePane.catalogue.items}}<button type="button" class="equipment-result{{#if previewing}} is-previewing{{/if}}" aria-label="{{previewAriaLabel}}" aria-pressed="{{#if previewing}}true{{else}}false{{/if}}" data-equipment-item data-source-uuid="{{sourceUuid}}" data-filter-rarity="{{rarity}}" data-filter-source="{{sourceLabel}}" data-filter-type="{{itemType}}" data-wayfinder-action="preview-equipment-item" data-wayfinder-focus-id="{{previewFocusId}}" data-step-id="{{../activePane.stepId}}">{{resultLabel}}</button>{{/each}}
  </div>
</div>

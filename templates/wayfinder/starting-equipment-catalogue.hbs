<div class="equipment-catalogue-projection" data-application-part="equipment-catalogue" data-step-id="{{activePane.stepId}}" data-wayfinder-rendered-query="{{activePane.catalogue.search}}" data-wayfinder-result-offset="{{activePane.catalogue.resultOffset}}" data-wayfinder-result-limit="{{activePane.catalogue.resultLimit}}" data-wayfinder-view-revision="{{equipmentRequest.viewRevision}}" data-wayfinder-source-revision="{{equipmentRequest.sourceRevision}}" data-wayfinder-criteria-revision="{{equipmentRequest.criteriaRevision}}">
  <div class="equipment-filter-row" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.FiltersAria"}}" aria-controls="{{activePane.stepId}}-equipment-results">
    {{#if activePane.catalogue.availabilityFilter}}<button type="button" class="equipment-type-chip{{#if activePane.catalogue.availabilityFilter.selected}} is-selected{{/if}}" aria-pressed="{{#if activePane.catalogue.availabilityFilter.selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{activePane.catalogue.availabilityFilter.focusId}}" data-step-id="{{activePane.stepId}}" data-filter-key="availability" data-value="available"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>{{activePane.catalogue.availabilityFilter.label}}</span><span class="equipment-filter-count">{{activePane.catalogue.availabilityFilter.count}}</span></button>{{/if}}
    {{#if activePane.catalogue.titanMaulerFilter}}<button type="button" class="equipment-type-chip{{#if activePane.catalogue.titanMaulerFilter.selected}} is-selected{{/if}}" aria-pressed="{{#if activePane.catalogue.titanMaulerFilter.selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{activePane.catalogue.titanMaulerFilter.focusId}}" data-step-id="{{activePane.stepId}}" data-filter-key="titan-mauler" data-value="eligible"><i class="fa-solid fa-hand-fist" aria-hidden="true"></i><span>{{activePane.catalogue.titanMaulerFilter.label}}</span><span class="equipment-filter-count">{{activePane.catalogue.titanMaulerFilter.count}}</span></button>{{/if}}
    {{#each activePane.catalogue.typeFilters}}<button type="button" class="equipment-type-chip{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span><span class="equipment-filter-count">{{count}}</span></button>{{/each}}

    <span class="equipment-filter-divider" aria-hidden="true"></span>

    {{#if activePane.catalogue.levelFilter}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.levelFilter.active}} is-active{{/if}}{{#if activePane.catalogue.levelPanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.levelPanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-level-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:level" data-step-id="{{activePane.stepId}}" data-filter-key="level"><span>{{activePane.catalogue.levelFilter.label}} · {{activePane.catalogue.levelFilter.summaryLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
    {{#if activePane.catalogue.rarityFilters.length}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.rarityFilterActive}} is-active{{/if}}{{#if activePane.catalogue.rarityPanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.rarityPanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-rarity-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:rarity" data-step-id="{{activePane.stepId}}" data-filter-key="rarity"><span>{{activePane.catalogue.rarityFilterLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
    {{#if activePane.catalogue.hasSourceFilters}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.sourceFilterActive}} is-active{{/if}}{{#if activePane.catalogue.sourcePanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.sourcePanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-source-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:source" data-step-id="{{activePane.stepId}}" data-filter-key="source"><span>{{activePane.catalogue.sourceFilterLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
    {{#if activePane.catalogue.hasTraitFilters}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.traitFilterActive}} is-active{{/if}}{{#if activePane.catalogue.traitPanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.traitPanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-trait-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:trait" data-step-id="{{activePane.stepId}}" data-filter-key="trait"><span>{{activePane.catalogue.traitFilterLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
  </div>

  {{#if activePane.catalogue.levelPanelOpen}}
    <div class="equipment-filter-panel" id="{{activePane.stepId}}-equipment-level-filters" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.LevelFiltersAria"}}">
      <div class="picker-level-range">
        <div class="picker-level-range-bound"><span class="picker-level-range-label">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.From"}}</span><div class="picker-level-range-values">{{#each activePane.catalogue.levelFilter.values}}<button type="button" class="picker-level-range-value{{#if minimumSelected}} is-selected{{/if}}" data-wayfinder-action="set-equipment-level-range" data-step-id="{{../activePane.stepId}}" data-minimum="{{minimumRangeStart}}" data-maximum="{{minimumRangeEnd}}" aria-pressed="{{#if minimumSelected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div></div>
        <div class="picker-level-range-bound"><span class="picker-level-range-label">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.Through"}}</span><div class="picker-level-range-values">{{#each activePane.catalogue.levelFilter.values}}<button type="button" class="picker-level-range-value{{#if maximumSelected}} is-selected{{/if}}" data-wayfinder-action="set-equipment-level-range" data-step-id="{{../activePane.stepId}}" data-minimum="{{maximumRangeStart}}" data-maximum="{{maximumRangeEnd}}" aria-pressed="{{#if maximumSelected}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}</div></div>
      </div>
    </div>
  {{/if}}

  {{#if activePane.catalogue.rarityPanelOpen}}
    <div class="equipment-filter-panel" id="{{activePane.stepId}}-equipment-rarity-filters" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.RarityFiltersAria"}}">
      {{#each activePane.catalogue.rarityFilters}}<button type="button" class="equipment-filter-option rarity-{{value}}{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><span class="equipment-filter-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span><span>{{label}}</span><span class="equipment-filter-count">{{count}}</span></button>{{/each}}
    </div>
  {{/if}}

  {{#if activePane.catalogue.sourcePanelOpen}}
    <div class="equipment-source-filter-panel" id="{{activePane.stepId}}-equipment-source-filters">
      <label class="search-shell compact">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" value="{{activePane.catalogue.sourceSearch}}" placeholder="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchPlaceholder"}}" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchAria"}}" aria-controls="{{activePane.stepId}}-equipment-source-options" data-wayfinder-equipment-source-search data-filter-key="source" data-wayfinder-focus-id="starting-equipment-source-search" data-step-id="{{activePane.stepId}}" />
      </label>
      <p role="status" aria-live="polite" aria-atomic="true">{{activePane.catalogue.sourceResultAnnouncement}}</p>
      <div id="{{activePane.stepId}}-equipment-source-options" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceFiltersAria"}}" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-source-filters">
        {{#each activePane.catalogue.sourceFilters}}<button type="button" class="equipment-filter-option{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><span class="equipment-filter-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span><span>{{label}}</span><span class="equipment-filter-count">{{count}}</span></button>{{/each}}
      </div>
    </div>
  {{/if}}

  {{#if activePane.catalogue.traitPanelOpen}}
    <div class="equipment-source-filter-panel" id="{{activePane.stepId}}-equipment-trait-filters">
      <label class="search-shell compact"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" value="{{activePane.catalogue.traitSearch}}" placeholder="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.TraitSearchPlaceholder"}}" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.TraitSearchAria"}}" aria-controls="{{activePane.stepId}}-equipment-trait-options" data-wayfinder-equipment-trait-search data-filter-key="trait" data-wayfinder-focus-id="starting-equipment-trait-search" data-step-id="{{activePane.stepId}}" /></label>
      <p role="status" aria-live="polite" aria-atomic="true">{{activePane.catalogue.traitResultAnnouncement}}</p>
      <div id="{{activePane.stepId}}-equipment-trait-options" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.TraitFiltersAria"}}" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-trait-filters">
        {{#each activePane.catalogue.traitFilters}}<button type="button" class="equipment-filter-option{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><span class="equipment-filter-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span><span>{{label}}</span><span class="equipment-filter-count">{{count}}</span></button>{{/each}}
      </div>
    </div>
  {{/if}}

  <p class="equipment-result-count" role="status" aria-live="{{#if equipmentRequest.announceWindow}}polite{{else}}off{{/if}}" aria-atomic="true">
    <span>{{activePane.catalogue.resultAnnouncement}}</span>
    {{#if activePane.catalogue.narrowSearchHint}}<small>{{activePane.catalogue.narrowSearchHint}}</small>{{/if}}
  </p>

  {{#unless activePane.catalogue.items.length}}
    <div class="equipment-catalogue-state {{activePane.catalogue.state}}" role="status" aria-live="polite" aria-atomic="true">
      <i class="fa-solid fa-box-open" aria-hidden="true"></i>
      <p>{{activePane.catalogue.message}}</p>
      {{#if activePane.catalogue.diagnostics.length}}
        <ul class="equipment-source-diagnostics">
          {{#each activePane.catalogue.diagnostics}}<li data-equipment-source-diagnostic="{{code}}"><strong>{{packId}}</strong>: {{message}}</li>{{/each}}
        </ul>
      {{/if}}
    </div>
  {{/unless}}

  <div class="equipment-result-list" id="{{activePane.stepId}}-equipment-results" role="list" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.ResultsAria"}}" aria-busy="false" tabindex="-1" data-equipment-focus-sentinel data-wayfinder-equipment-virtual-list data-total-results="{{activePane.catalogue.totalResultCount}}" data-result-offset="{{activePane.catalogue.resultOffset}}" data-wayfinder-rendered-query="{{activePane.catalogue.search}}" data-wayfinder-view-revision="{{equipmentRequest.viewRevision}}" data-wayfinder-source-revision="{{equipmentRequest.sourceRevision}}" data-wayfinder-criteria-revision="{{equipmentRequest.criteriaRevision}}" data-step-id="{{activePane.stepId}}" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-results">
    <div class="equipment-result-spacer" style="height: {{activePane.catalogue.leadingSpacerPx}}px" data-equipment-leading-spacer aria-hidden="true"></div>
    <div class="equipment-result-skeleton-band" data-equipment-skeleton-band aria-hidden="true" hidden></div>
    {{#each activePane.catalogue.items}}
      <article class="equipment-result-row{{#if previewing}} is-previewing{{/if}}{{#unless canAdd}} is-blocked{{/unless}}" role="listitem" aria-posinset="{{resultPosition}}" aria-setsize="{{../activePane.catalogue.totalResultCount}}" data-result-index="{{resultIndex}}" data-source-uuid="{{sourceUuid}}">
        <button type="button" class="equipment-result" aria-label="{{previewAriaLabel}}" aria-pressed="{{#if previewing}}true{{else}}false{{/if}}" data-equipment-item data-source-uuid="{{sourceUuid}}" data-filter-rarity="{{rarity}}" data-filter-source="{{sourceLabel}}" data-filter-type="{{itemType}}" data-wayfinder-action="preview-equipment-item" data-wayfinder-focus-id="{{previewFocusId}}" data-step-id="{{../activePane.stepId}}">
          <span class="equipment-result-art"><i class="fa-solid {{typeIcon}}" aria-hidden="true"></i></span>
          <span class="equipment-result-copy">
            <span class="equipment-result-title">
              <span class="equipment-result-name">{{name}}</span>
              <span class="tag equipment-result-level">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.LevelTag" level=level}}</span>
              {{#unless (eq rarity "common")}}<span class="tag rarity-{{rarity}}">{{rarityLabel}}</span>{{/unless}}
            </span>
            <span class="equipment-result-meta">{{itemTypeLabel}} · {{sourceLabel}}{{#if unavailableReason}} · <span class="equipment-result-block">{{unavailableReason}}</span>{{/if}}</span>
          </span>
          <span class="equipment-result-price{{#unless canAdd}} is-unaffordable{{/unless}}">{{priceLabel}}</span>
        </button>
      </article>
    {{/each}}
    <div class="equipment-result-spacer" style="height: {{activePane.catalogue.trailingSpacerPx}}px" data-equipment-trailing-spacer aria-hidden="true"></div>
  </div>
  {{#if activePane.catalogue.hasPreviousWindow}}
    <button type="button" class="equipment-window-fallback previous" data-wayfinder-action="set-equipment-result-window" data-step-id="{{activePane.stepId}}" data-offset="{{activePane.catalogue.previousWindowOffset}}">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.PreviousResults"}}</button>
  {{/if}}
  {{#if activePane.catalogue.hasNextWindow}}
    <button type="button" class="equipment-window-fallback next" data-wayfinder-action="set-equipment-result-window" data-step-id="{{activePane.stepId}}" data-offset="{{activePane.catalogue.nextWindowOffset}}">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.NextResults"}}</button>
  {{/if}}
</div>

<section class="starting-equipment-pane" aria-label="Starting equipment">
  <section class="equipment-policy-summary" aria-label="Effective starting-equipment policy">
    <article><span>Funding</span><strong>{{activePane.policy.recipeLabel}}</strong></article>
    <article><span>Budget</span><strong>{{activePane.policy.budgetLabel}}</strong></article>
    <article><span>What you can buy</span><strong>{{activePane.policy.automaticEligibilityLabel}}</strong></article>
    <article><span>Who decides</span><strong>{{activePane.policy.authorityLabel}}</strong></article>
    <article class="equipment-policy-handoff"><span>Gear you already own</span><strong>{{activePane.policy.handoffLabel}}</strong></article>
    {{#each activePane.policy.explanations}}<p><i class="fa-solid fa-circle-info" aria-hidden="true"></i>{{this}}</p>{{/each}}
    {{#if activePane.policy.allowances.length}}
      <div class="equipment-allowance-summary" aria-label="Permanent item allowances">
        {{#each activePane.policy.allowances}}<span class="{{#if used}}is-used{{/if}}"><strong>{{label}}</strong><small>{{#if used}}Assigned{{else}}Available{{/if}}</small></span>{{/each}}
      </div>
    {{/if}}
  </section>

  {{#if activePane.corrupt}}
    <section class="equipment-callout error" tabindex="-1" data-wayfinder-focus-id="starting-equipment-initialize">
      <h4>This equipment draft is damaged</h4>
      <p>Wayfinder can't read the saved cart, and it won't guess at what you owned or spent. Clear the draft to start this step again.</p>
    </section>
  {{else}}
    {{#unless activePane.initialized}}
      <section class="equipment-callout" tabindex="-1" data-wayfinder-focus-id="starting-equipment-initialize">
        <h4>Before you shop</h4>
        <p>Wayfinder reads your world's equipment rules and notes what your character already carries. Nothing gets bought or spent yet.</p>
        <button type="button" class="primary" data-wayfinder-action="initialize-starting-equipment" data-step-id="{{activePane.stepId}}">Start Shopping</button>
      </section>
    {{else}}
      {{#if activePane.setup.awaitingAuthority}}
        <section class="equipment-callout" tabindex="-1" data-wayfinder-focus-id="starting-equipment-authority">
          <h4>Confirm this higher-level start</h4>
          <p>{{activePane.setup.authorityMessage}}</p>
          {{#if activePane.setup.recipeOptions.length}}
            <div class="equipment-setup-recipes" role="group" aria-label="Starting wealth recipe">
              {{#each activePane.setup.recipeOptions}}
                <button type="button" class="secondary{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="select-equipment-recipe" data-step-id="{{../activePane.stepId}}" data-recipe="{{value}}" {{#unless ../activePane.setup.canChooseRecipe}}disabled{{/unless}}>{{label}}</button>
              {{/each}}
            </div>
          {{/if}}
          {{#if activePane.setup.canActivate}}
            <div class="equipment-setup-actions">
              <button type="button" class="secondary" data-wayfinder-action="activate-equipment-policy" data-step-id="{{activePane.stepId}}" data-start-kind="new-campaign">New Campaign Character</button>
              <button type="button" class="primary" data-wayfinder-action="activate-equipment-policy" data-step-id="{{activePane.stepId}}" data-start-kind="replacement-character">Replacement Character</button>
            </div>
          {{/if}}
        </section>
      {{else if activePane.handoff.active}}
        <section class="equipment-callout warning" tabindex="-1" data-wayfinder-focus-id="starting-equipment-handoff">
          <h4>Finish this on your character sheet</h4>
          {{#each activePane.handoff.reasons}}<p>{{this}}</p>{{/each}}
          {{#unless activePane.handoff.acknowledged}}
            <button type="button" class="primary" data-wayfinder-action="acknowledge-equipment-handoff" data-step-id="{{activePane.stepId}}">Got It</button>
          {{else}}
            <p class="equipment-reviewed"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>Noted. Wayfinder won't add items or touch your coin.</p>
          {{/unless}}
        </section>
      {{else}}
        {{#if activePane.titanMauler.required}}
          <section class="equipment-callout warning titan-mauler-callout" tabindex="-1" data-wayfinder-focus-id="starting-equipment-titan-mauler">
            {{#if activePane.titanMauler.selected}}
              <h4>Your Titan Mauler weapon</h4>
              <p><strong>{{activePane.titanMauler.selectedName}}</strong> comes free with Giant Instinct. You get exactly one, it costs you nothing, and it's worth nothing if you sell it until you put runes in it. Take it out of the cart to swap for a different weapon.</p>
            {{else}}
              <h4>Pick your Titan Mauler weapon</h4>
              <p>Giant Instinct hands you one level-0 Common weapon, melee or ranged, priced at 9 gp or less. A weapon your character has a registered Access for counts too. Wayfinder builds it oversized to suit your ancestry, charges you nothing for it, and remembers that it can't be sold on.</p>
              <p>Hit <strong>Choose as Titan Mauler</strong> on a weapon below before you finish this step.</p>
            {{/if}}
          </section>
        {{/if}}
        <div class="equipment-workspace">
          <section class="equipment-catalogue" aria-label="Equipment catalogue">
            <div class="equipment-search-row">
              <input type="search" value="{{activePane.catalogue.search}}" placeholder="Search gear by name, source, or rarity…" aria-label="Search equipment" data-wayfinder-equipment-search data-step-id="{{activePane.stepId}}" {{#if activePane.catalogue.searchDisabled}}disabled{{/if}} />
              <button type="button" class="secondary compact" data-wayfinder-action="clear-equipment-filters" data-step-id="{{activePane.stepId}}" {{#if activePane.catalogue.searchDisabled}}disabled{{/if}}>Clear Filters</button>
            </div>
            <div class="equipment-filter-row" aria-label="Equipment filters">
              {{#each activePane.catalogue.filters}}
                <button type="button" class="secondary compact{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}">{{label}}</button>
              {{/each}}
            </div>
            <p class="equipment-result-count">Showing {{activePane.catalogue.visibleResultCount}} of {{activePane.catalogue.totalResultCount}} matching items</p>
            {{#unless activePane.catalogue.items.length}}
              <div class="equipment-catalogue-state {{activePane.catalogue.state}}"><i class="fa-solid fa-box-open" aria-hidden="true"></i><p>{{activePane.catalogue.message}}</p></div>
            {{/unless}}
            <div class="equipment-result-list" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-results">
              {{#each activePane.catalogue.items}}
                <article class="equipment-result{{#if previewing}} is-previewing{{/if}}" data-equipment-item data-source-uuid="{{sourceUuid}}" data-filter-rarity="{{rarity}}" data-filter-source="{{sourceLabel}}" data-filter-type="{{itemType}}">
                  <button type="button" class="equipment-result-main" data-wayfinder-action="preview-equipment-item" data-step-id="{{../activePane.stepId}}" data-source-uuid="{{sourceUuid}}">
                    <span><strong>{{name}}</strong><small>Level {{level}} · {{rarity}} · {{sourceLabel}}</small></span>
                  </button>
                  <span class="equipment-result-price">{{priceLabel}}</span>
                  <div class="equipment-result-actions">
                    {{#if canBuyWithCurrency}}<button type="button" class="primary compact" data-wayfinder-action="add-equipment-item" data-step-id="{{../activePane.stepId}}" data-source-uuid="{{sourceUuid}}" data-funding="currency">Buy with coin</button>{{/if}}
                    {{#each allowanceOptions}}<button type="button" class="secondary compact" data-wayfinder-action="add-equipment-item" data-step-id="{{../../activePane.stepId}}" data-source-uuid="{{../sourceUuid}}" data-funding="allowance" data-allowance-id="{{allowanceId}}">{{label}}</button>{{/each}}
                    {{#unless canAdd}}<button type="button" class="primary compact" disabled>Add</button>{{/unless}}
                    {{#if canChooseTitanMauler}}<button type="button" class="secondary compact" data-wayfinder-action="choose-titan-mauler-equipment" data-step-id="{{../activePane.stepId}}" data-source-uuid="{{sourceUuid}}">Choose as Titan Mauler</button>{{/if}}
                  </div>
                  {{#if unavailableReason}}<small class="equipment-unavailable">{{unavailableReason}}</small>{{else}}{{#unless canAdd}}<small class="equipment-unavailable">No available funding option can cover this item.</small>{{/unless}}{{/if}}
                </article>
              {{/each}}
            </div>
          </section>

          <aside class="equipment-detail" aria-label="Equipment item detail">
            {{#each activePane.catalogue.items}}
              <article data-equipment-preview="{{sourceUuid}}" {{#unless previewing}}hidden{{/unless}}>
                <p class="eyebrow">Level {{level}} · {{rarity}}</p><h4>{{name}}</h4>
                <dl><div><dt>Price</dt><dd>{{priceLabel}}</dd></div><div><dt>Bulk</dt><dd>{{bulkLabel}}</dd></div><div><dt>Hands</dt><dd>{{handsLabel}}</dd></div><div><dt>Traits</dt><dd>{{traits}}</dd></div></dl>
              </article>
            {{/each}}
            {{#unless activePane.catalogue.preview}}<p class="equipment-detail-empty">Pick something on the left to see its price, bulk, hands, and traits.</p>{{/unless}}
          </aside>

          <section class="equipment-cart" aria-label="Starting-equipment cart">
            <header><div><p class="eyebrow">Cart</p><h4>Your kit</h4></div><dl><div><dt>Spent</dt><dd>{{activePane.cart.spentLabel}}</dd></div><div><dt>Remaining</dt><dd>{{activePane.cart.remainingLabel}}</dd></div></dl></header>
            {{#if activePane.cart.empty}}<p class="equipment-cart-empty">Nothing in the cart yet. If you would rather keep the coin, say so with Keep It All.</p>{{/if}}
            {{#each activePane.cart.lines}}
              <article class="equipment-cart-line" tabindex="-1" data-wayfinder-focus-id="{{focusId}}">
                <span><strong>{{name}}</strong><small>{{fundingLabel}} · {{priceLabel}}</small>{{#if unavailableReason}}<small class="equipment-unavailable">{{unavailableReason}}</small>{{/if}}</span>
                {{#if canChangeQuantity}}
                  <div class="equipment-quantity" aria-label="Quantity for {{name}}"><button type="button" data-wayfinder-action="change-equipment-quantity" data-step-id="{{../activePane.stepId}}" data-line-id="{{lineId}}" data-delta="-1" aria-label="Decrease quantity">−</button><strong>{{quantity}}</strong><button type="button" data-wayfinder-action="change-equipment-quantity" data-step-id="{{../activePane.stepId}}" data-line-id="{{lineId}}" data-delta="1" aria-label="Increase quantity">+</button></div>
                {{else}}
                  <div class="equipment-quantity" aria-label="Fixed quantity for {{name}}"><strong>{{quantity}}</strong></div>
                {{/if}}
                {{#if canRemove}}<button type="button" class="icon" data-wayfinder-action="remove-equipment-line" data-step-id="{{../activePane.stepId}}" data-line-id="{{lineId}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash" aria-hidden="true"></i></button>{{/if}}
              </article>
            {{/each}}
            <footer tabindex="-1" data-wayfinder-focus-id="starting-equipment-review"><span><strong>{{activePane.review.label}}</strong><small>Apply checks prices and your world's rules once more before anything is bought.</small></span><div><button type="button" class="secondary" data-wayfinder-action="retain-all-equipment" data-step-id="{{activePane.stepId}}" {{#unless activePane.review.canRetainAll}}disabled{{/unless}}>Keep It All</button><button type="button" class="primary" data-wayfinder-action="review-equipment-purchases" data-step-id="{{activePane.stepId}}" {{#unless activePane.review.canReviewPurchases}}disabled{{/unless}}>Confirm Kit</button></div></footer>
          </section>
        </div>
      {{/if}}
    {{/unless}}
  {{/if}}
</section>

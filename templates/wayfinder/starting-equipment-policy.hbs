<div class="equipment-render-policy" data-application-part="equipment-policy" data-step-id="{{activePane.stepId}}">
<section class="equipment-policy-summary" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Policy.Aria"}}">
  <p class="eyebrow">{{localize "wayfinder-pf2e.StartingEquipment.Policy.Heading"}}</p>

  <dl class="equipment-policy-primary">
    <div class="equipment-term">
      <dt>{{localize "wayfinder-pf2e.StartingEquipment.Policy.Funding"}}</dt>
      <dd>{{activePane.policy.recipeLabel}}</dd>
    </div>
    <div class="equipment-term is-emphasis">
      <dt>{{localize "wayfinder-pf2e.StartingEquipment.Policy.Budget"}}</dt>
      <dd aria-live="polite" aria-atomic="true">{{#if activePane.setup.awaitingAuthority}}{{localize "wayfinder-pf2e.StartingEquipment.Policy.BudgetPending"}}{{else}}{{activePane.policy.budgetLabel}}{{/if}}</dd>
    </div>
    <div class="equipment-term">
      <dt>{{localize "wayfinder-pf2e.StartingEquipment.Policy.Eligibility"}}</dt>
      <dd>{{activePane.policy.automaticEligibilityLabel}}</dd>
    </div>
    <div class="equipment-term">
      <dt>{{localize "wayfinder-pf2e.StartingEquipment.Policy.Authority"}}</dt>
      <dd>{{activePane.policy.authorityLabel}}</dd>
    </div>
    <div class="equipment-term">
      <dt>{{localize "wayfinder-pf2e.StartingEquipment.Policy.SelectedBy"}}</dt>
      <dd>{{activePane.policy.recipeSelectionLabel}}</dd>
    </div>
  </dl>

  {{#if activePane.policy.allowances.length}}
    <div class="equipment-allowance-summary" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Allowance.Aria"}}">
      <span class="equipment-allowance-heading">{{localize "wayfinder-pf2e.StartingEquipment.Allowance.Heading"}}</span>
      <ul>
        {{#each activePane.policy.allowances}}
          <li class="equipment-allowance-chip{{#if used}} is-used{{/if}}">
            <i class="fa-solid {{#if used}}fa-circle-check{{else}}fa-circle{{/if}}" aria-hidden="true"></i>
            <strong>{{label}}</strong>
            <small>{{statusLabel}}</small>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  <details class="equipment-policy-details">
    <summary>{{localize "wayfinder-pf2e.StartingEquipment.Policy.Details"}}</summary>
    <p class="equipment-policy-context">
      {{localize "wayfinder-pf2e.StartingEquipment.Policy.ExistingGear"}}: {{activePane.policy.handoffLabel}}
      {{#each activePane.policy.explanations}} {{this}}{{/each}}
    </p>
  {{#if activePane.policy.gmToolsAvailable}}
    <div class="equipment-gm-tools">
      <span class="equipment-gm-tools-label"><i class="fa-solid fa-crown" aria-hidden="true"></i>{{localize "wayfinder-pf2e.StartingEquipment.Policy.GmTools"}}</span>
      {{#if activePane.setup.canRevoke}}<button type="button" class="secondary compact" data-wayfinder-action="revoke-equipment-policy-judgment" data-wayfinder-focus-id="starting-equipment-revoke-approval" data-step-id="{{activePane.stepId}}" data-judgment-id="{{activePane.setup.activeJudgmentId}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.RevokeApproval"}}</button>{{/if}}
      {{#if activePane.setup.canGrantExtraAllowance}}<button type="button" class="secondary compact" data-wayfinder-action="grant-extra-equipment-allowance" data-wayfinder-focus-id="starting-equipment-grant-allowance" data-step-id="{{activePane.stepId}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.GrantExtraAllowance" level=activePane.level}}</button>{{/if}}
      {{#if activePane.setup.canSetCustomLumpSum}}
        <div class="equipment-gm-override">
          <label><span>{{localize "wayfinder-pf2e.StartingEquipment.Actions.CustomLumpSum"}}</span><input type="number" min="0" step="0.01" data-wayfinder-custom-lump-sum data-step-id="{{activePane.stepId}}" /></label>
          <button type="button" class="secondary compact" data-wayfinder-action="set-custom-equipment-lump-sum" data-wayfinder-focus-id="starting-equipment-custom-sum" data-step-id="{{activePane.stepId}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.ApproveCustomSum"}}</button>
        </div>
      {{/if}}
    </div>
  {{/if}}
  </details>

  {{#if activePane.setup.requestOutcomeMessage}}
    <p class="equipment-policy-request-outcome"><i class="fa-solid fa-circle-info" aria-hidden="true"></i>{{activePane.setup.requestOutcomeMessage}}</p>
  {{/if}}

  {{#each activePane.setup.pendingRequests}}
    <article class="equipment-policy-request">
      <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
      <div class="equipment-policy-request-copy">
        <p>{{localize "wayfinder-pf2e.StartingEquipment.Request.RequestedBy" kind=kindLabel requesterName=requesterName requestedAt=requestedAtLabel}}</p>
        {{#if reason}}<p class="equipment-policy-request-reason">{{reason}}</p>{{/if}}
      </div>
      <div class="equipment-policy-request-actions">
        {{#if canDecline}}<button type="button" class="secondary compact" data-wayfinder-action="decline-equipment-policy-request" data-wayfinder-focus-id="starting-equipment-decline-request:{{requestId}}" data-step-id="{{../activePane.stepId}}" data-request-id="{{requestId}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.DeclineRequest"}}</button>{{/if}}
        {{#if canApprove}}<button type="button" class="primary compact" data-wayfinder-action="approve-equipment-policy-request" data-wayfinder-focus-id="starting-equipment-approve-request:{{requestId}}" data-step-id="{{../activePane.stepId}}" data-request-id="{{requestId}}">{{#if approvalRecorded}}{{localize "wayfinder-pf2e.StartingEquipment.Actions.RetryApproval"}}{{else}}{{localize "wayfinder-pf2e.StartingEquipment.Actions.ApproveRequest"}}{{/if}}</button>{{/if}}
      </div>
    </article>
  {{/each}}
</section>

{{#if activePane.setup.awaitingAuthority}}
  <section class="equipment-callout equipment-authority" tabindex="-1" data-wayfinder-focus-id="starting-equipment-authority">
    <i class="equipment-callout-mark fa-solid fa-scale-balanced" aria-hidden="true"></i>
    <div class="equipment-callout-copy">
    <h4>{{localize "wayfinder-pf2e.StartingEquipment.Authority.ConfirmTitle"}}</h4>
    <p>{{activePane.setup.authorityMessage}}</p>
    <div class="equipment-setup-groups">

    {{#if activePane.setup.recipeOptions.length}}
      <div class="equipment-setup-group">
        <span class="equipment-setup-legend">{{localize "wayfinder-pf2e.StartingEquipment.Authority.RecipeHeading"}}</span>
        <div class="equipment-setup-recipes" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Recipe.Aria"}}">
          {{#each activePane.setup.recipeOptions}}
            <button type="button" class="secondary{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="select-equipment-recipe" data-wayfinder-focus-id="starting-equipment-recipe:{{value}}" data-step-id="{{../activePane.stepId}}" data-recipe="{{value}}" {{#unless ../activePane.setup.canChooseRecipe}}disabled{{/unless}}>{{label}}</button>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{#if activePane.setup.canActivate}}
      <div class="equipment-setup-group">
        <span class="equipment-setup-legend">{{localize "wayfinder-pf2e.StartingEquipment.Authority.StartHeading"}}</span>
        <div class="equipment-setup-actions">
          <button type="button" class="secondary" data-wayfinder-action="activate-equipment-policy" data-wayfinder-focus-id="starting-equipment-activate:new-campaign" data-step-id="{{activePane.stepId}}" data-start-kind="new-campaign">{{localize "wayfinder-pf2e.StartingEquipment.Actions.NewCampaignCharacter"}}</button>
          <button type="button" class="secondary" data-wayfinder-action="activate-equipment-policy" data-wayfinder-focus-id="starting-equipment-activate:replacement-character" data-step-id="{{activePane.stepId}}" data-start-kind="replacement-character">{{localize "wayfinder-pf2e.StartingEquipment.Actions.ReplacementCharacter"}}</button>
        </div>
      </div>
    {{/if}}

    {{#if activePane.setup.canRequest}}
      <div class="equipment-setup-group">
        <span class="equipment-setup-legend">{{localize "wayfinder-pf2e.StartingEquipment.Authority.StartHeading"}}</span>
        <div class="equipment-setup-actions">
          <button type="button" class="secondary" data-wayfinder-action="request-equipment-start" data-wayfinder-focus-id="starting-equipment-request:new-campaign" data-step-id="{{activePane.stepId}}" data-start-kind="new-campaign">{{localize "wayfinder-pf2e.StartingEquipment.Actions.RequestNewCampaign"}}</button>
          <button type="button" class="secondary" data-wayfinder-action="request-equipment-start" data-wayfinder-focus-id="starting-equipment-request:replacement-character" data-step-id="{{activePane.stepId}}" data-start-kind="replacement-character">{{localize "wayfinder-pf2e.StartingEquipment.Actions.RequestReplacement"}}</button>
        </div>
      </div>
    {{/if}}
    </div>
    </div>
  </section>
{{/if}}
</div>

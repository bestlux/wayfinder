<section class="wayfinder-shell">
  {{#if existingCharacterHistory}}
    <details class="history-report">
      <summary>
        <span>
          <strong>What this character already has</strong>
          <small>{{existingCharacterHistory.mappedCount}} traced · {{existingCharacterHistory.reviewCount}} need a look</small>
        </span>
        <button type="button" class="secondary history-refresh" data-wayfinder-action="import-existing-history">Read the sheet again</button>
      </summary>
      <div class="history-report-body">
        <p class="history-scope">
          Wayfinder traces only what it can prove from the sheet itself. Where a boost, skill increase, or granted choice could have come from more than one place, it says so instead of guessing.
        </p>
        <div class="history-levels">
          {{#each existingCharacterHistory.levels}}
            <section class="history-level">
              <h3>Level {{level}}</h3>
              <div class="history-entries">
                {{#each entries}}
                  <article class="history-entry {{status}}">
                    <i class="fa-solid {{#if mapped}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}"></i>
                    <span>
                      <strong>{{label}}</strong>
                      <small>{{value}}</small>
                    </span>
                  </article>
                {{/each}}
              </div>
            </section>
          {{/each}}
        </div>
      </div>
    </details>
  {{else}}
    {{#if canImportExistingHistory}}
      <section class="history-import">
        <span>
          <strong>Already built this character?</strong>
          <small>Trace the choices already on the sheet into a level-by-level history. Nothing gets rewritten.</small>
        </span>
        <button type="button" class="primary" data-wayfinder-action="import-existing-history">Trace This Character</button>
      </section>
    {{/if}}
  {{/if}}

  {{#if planningNote}}
    <div class="status-note">
      <i class="fa-solid fa-circle-info"></i>
      <span>{{planningNote}}</span>
    </div>
  {{/if}}

  {{#if hasPendingSteps}}
    <section class="wizard-frame">
      <aside class="wizard-rail">
        <header class="rail-header">
          <p class="eyebrow">Wayfinder</p>
          <h2 class="rail-actor-name">{{actorName}}</h2>
          <p class="rail-dossier-line">{{dossierLine}}</p>

          <div class="rail-status-row">
            <div class="level-card">
              <div class="level-badge">
                <span class="level-label">Cur</span>
                <strong>{{currentLevel}}</strong>
              </div>
              <div class="level-badge target">
                <span class="level-label">Tgt</span>
                <strong>{{targetLevel}}</strong>
              </div>
            </div>

            <div class="target-controls">
              <button type="button" class="icon" data-wayfinder-action="target-down" aria-label="Lower target level">
                <i class="fa-solid fa-minus"></i>
              </button>
              <button type="button" class="icon" data-wayfinder-action="target-up" aria-label="Raise target level">
                <i class="fa-solid fa-plus"></i>
              </button>
            </div>

            <div class="rail-progress">
              <div class="progress-dots">
                {{#each steps}}
                  <span class="progress-dot{{#if complete}} filled{{/if}}{{#if active}} active{{/if}}{{#if invalidated}} warn{{/if}}" title="{{title}}"></span>
                {{/each}}
              </div>
              <span class="progress-label">{{completedCount}}/{{stepCount}}</span>
            </div>
          </div>
        </header>

        <div class="wizard-step-list" data-wayfinder-scroll-id="wizard-steps">
          {{#each steps}}
            {{#if firstInLevel}}
              <div class="step-level-divider">
                <span class="step-level-divider-label">Level {{level}}</span>
              </div>
            {{/if}}
            <button type="button" class="step-link{{#if active}} active{{/if}}{{#if complete}} complete{{/if}}{{#if invalidated}} invalidated{{/if}}" data-wayfinder-action="select-step" data-step-id="{{id}}">
              <span class="step-index">{{index}}</span>
              <span class="step-copy">
                <span class="step-title">{{title}}</span>
                <span class="step-status">{{status}}</span>
              </span>
            </button>
          {{/each}}
        </div>
      </aside>

      <main class="wizard-stage" data-wayfinder-scroll-id="{{#if activePane}}{{activePane.stepId}}:stage{{else}}wizard-stage{{/if}}">
        {{#if activePane}}
          <header class="stage-bar">
            <div class="stage-bar-copy">
              <span class="stage-bar-step">Step {{activeStepIndex}}</span>
              <h3 tabindex="-1" data-wayfinder-step-heading="{{activePane.stepId}}">{{activePane.title}}</h3>
              <span class="step-badge">Level {{activePane.level}} · {{activePane.modeLabel}}</span>
            </div>

            <div class="step-nav-controls">
              <button type="button" class="nav-btn" data-wayfinder-action="previous-step" {{#unless canGoPrevious}}disabled{{/unless}} aria-label="Previous step">
                <i class="fa-solid fa-chevron-left"></i>
              </button>
              <button type="button" class="nav-btn" data-wayfinder-action="next-step" {{#unless canGoNext}}disabled{{/unless}} aria-label="Next step">
                <i class="fa-solid fa-chevron-right"></i>
              </button>
            </div>
          </header>

          {{#if (eq activePane.templateKind "starting-equipment")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/starting-equipment-status.hbs"}}
          {{else}}
            {{#if statusNote}}
              <div class="status-note{{#if statusNoteIsError}} error{{/if}}" role="{{#if statusNoteIsError}}alert{{else}}status{{/if}}" aria-live="{{#if statusNoteIsError}}assertive{{else}}polite{{/if}}" aria-atomic="true" {{#if statusNoteIsError}}tabindex="-1" data-wayfinder-focus-id="starting-equipment-status"{{/if}}>
                <i class="fa-solid {{#if statusNoteIsError}}fa-triangle-exclamation{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
                <span>{{statusNote}}</span>
              </div>
            {{/if}}
          {{/if}}

          {{#if (eq activePane.templateKind "manual")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/manual-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "boost")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/boost-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "skill-increase")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/skill-increase-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "skill-training")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/skill-training-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "singleton-choice")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/singleton-choice-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "language-choice")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/language-choice-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "class-choice")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/class-choice-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "spell-choice")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/spell-choice-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "pick-item")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/pick-pane.hbs"}}
          {{/if}}

          {{#if (eq activePane.templateKind "starting-equipment")}}
            {{> "modules/wayfinder-pf2e/templates/wayfinder/starting-equipment-pane.hbs"}}
          {{/if}}
        {{/if}}
      </main>
    </section>
  {{else}}
    <section class="wayfinder-empty wayfinder-empty-planner">
      {{#if statusNote}}
        <div class="status-note{{#if statusNoteIsError}} error{{/if}}" role="{{#if statusNoteIsError}}alert{{else}}status{{/if}}" aria-live="{{#if statusNoteIsError}}assertive{{else}}polite{{/if}}" aria-atomic="true" {{#if statusNoteIsError}}tabindex="-1" data-wayfinder-focus-id="starting-equipment-status"{{/if}}>
          <i class="fa-solid {{#if statusNoteIsError}}fa-triangle-exclamation{{else}}fa-circle-info{{/if}}" aria-hidden="true"></i>
          <span>{{statusNote}}</span>
        </div>
      {{/if}}
      <div class="empty-planner-copy">
        <p class="eyebrow">Wayfinder</p>
        <h2>{{actorName}}</h2>
        <p>{{localize "wayfinder-pf2e.App.NoPending"}}</p>
        <small>Raise the target level to plan what comes next.</small>
      </div>

      <div class="empty-planner-levels" aria-label="Character level planning">
        <div class="level-card">
          <div class="level-badge">
            <span class="level-label">Cur</span>
            <strong>{{currentLevel}}</strong>
          </div>
          <div class="level-badge target">
            <span class="level-label">Tgt</span>
            <strong>{{targetLevel}}</strong>
          </div>
        </div>

        <div class="target-controls">
          <button type="button" class="icon" data-wayfinder-action="target-down" aria-label="Lower target level">
            <i class="fa-solid fa-minus"></i>
          </button>
          <button type="button" class="icon" data-wayfinder-action="target-up" aria-label="Raise target level">
            <i class="fa-solid fa-plus"></i>
          </button>
        </div>
      </div>
    </section>
  {{/if}}

  {{#if acquisitionReceipt}}
    {{> "modules/wayfinder-pf2e/templates/wayfinder/acquisition-receipt.hbs"}}
  {{/if}}

  {{#if lastAppliedSpellRarityAttestations.length}}
    <section class="wayfinder-attestation-receipt" aria-label="Spell access notes from the last apply">
      <p class="eyebrow">Last apply</p>
      <h3>Spell access notes</h3>
      <p class="attestation-disclaimer">These are the player's word, not a check Wayfinder ran.</p>
      {{#each lastAppliedSpellRarityAttestations}}
        <article>
          <h4>{{subjectLabel}}</h4>
          <dl>
            <div><dt>Claimed under</dt><dd>{{basisLabel}}</dd></div>
            <div><dt>Reason</dt><dd>{{reason}}</dd></div>
            <div><dt>Written by</dt><dd>{{authorName}}</dd></div>
            <div><dt>Written at</dt><dd><time datetime="{{attestedAt}}">{{attestedAt}}</time></dd></div>
            <div><dt>Selected spells</dt><dd>{{selectedSpellNames}}</dd></div>
          </dl>
        </article>
      {{/each}}
    </section>
  {{/if}}

  <footer class="wayfinder-footer">
    <div class="footer-support">
      <button type="button" class="footer-clear" data-wayfinder-action="clear-draft" {{#if lifecycleBusy}}disabled{{/if}}>Clear Draft</button>
      <button
        type="button"
        class="footer-feedback"
        data-wayfinder-action="open-feedback"
        data-tooltip="{{localize "wayfinder-pf2e.App.FeedbackTooltip"}}"
        aria-label="{{localize "wayfinder-pf2e.App.FeedbackAria"}}"
      >{{localize "wayfinder-pf2e.App.Feedback"}}</button>
    </div>
    <div
      class="footer-save-status {{draftSave.phase}}"
      data-wayfinder-save-status
      data-phase="{{draftSave.phase}}"
      role="{{#if draftSave.error}}alert{{else}}status{{/if}}"
      aria-live="{{draftSave.live}}"
      aria-atomic="true"
      {{#unless draftSave.visible}}hidden{{/unless}}
    >
      <i class="fa-solid {{#if draftSave.saving}}fa-spinner fa-spin{{else}}{{#if draftSave.saved}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}{{/if}}" aria-hidden="true"></i>
      <span data-wayfinder-save-message>{{#if draftSave.message}}{{draftSave.message}}{{else}}{{localize draftSave.labelKey}}{{/if}}</span>
      <button type="button" class="footer-save-retry" data-wayfinder-action="retry-draft-save" {{#unless draftSave.retryable}}hidden{{/unless}}>{{localize "wayfinder-pf2e.App.DraftSaveRetry"}}</button>
    </div>
    {{#if applyBlocker}}
      <button type="button" class="footer-readiness" data-wayfinder-action="select-step" data-step-id="{{applyBlocker.stepId}}" data-focus-id="{{applyBlocker.focusId}}">
        <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
        <span>{{applyBlocker.message}}</span>
      </button>
    {{/if}}
    <div class="footer-actions">
      <button type="button" class="secondary" data-wayfinder-action="save-draft" {{#if lifecycleBusy}}disabled{{/if}}>Save Draft</button>
      <button type="button" class="primary" data-wayfinder-action="apply-draft" data-wayfinder-readiness-ready="{{readinessReady}}" {{#unless canApplyDraft}}disabled{{/unless}} {{#if applyBlocker}}aria-label="Not ready to apply. {{applyBlocker.message}}"{{/if}}>Apply Changes</button>
    </div>
  </footer>
</section>

<section class="wayfinder-acquisition-receipt" aria-label="{{localize "wayfinder-pf2e.AcquisitionReceipt.Aria"}}" data-wayfinder-scroll-id="acquisition-receipt">
  <header>
    <div>
      <p class="eyebrow">{{localize "wayfinder-pf2e.AcquisitionReceipt.Eyebrow"}}</p>
      <h3>{{localize "wayfinder-pf2e.StartingEquipment.Title"}}</h3>
      <p>{{acquisitionReceipt.dispositionLabel}}</p>
    </div>
    {{#if acquisitionReceipt.canOpenInventory}}
      <button type="button" class="secondary" data-wayfinder-action="open-inventory">
        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
        {{localize "wayfinder-pf2e.AcquisitionReceipt.OpenInventory"}}
      </button>
    {{/if}}
  </header>

  <dl class="acquisition-receipt-summary">
    <div><dt>{{localize "wayfinder-pf2e.AcquisitionReceipt.AppliedBy"}}</dt><dd>{{acquisitionReceipt.appliedBy}}</dd></div>
    <div><dt>{{localize "wayfinder-pf2e.AcquisitionReceipt.AppliedAt"}}</dt><dd><time datetime="{{acquisitionReceipt.appliedAt}}">{{acquisitionReceipt.appliedAt}}</time></dd></div>
    <div><dt>{{localize "wayfinder-pf2e.AcquisitionReceipt.Spent"}}</dt><dd>{{acquisitionReceipt.currency.spentLabel}}</dd></div>
    <div><dt>{{localize "wayfinder-pf2e.AcquisitionReceipt.Remaining"}}</dt><dd>{{acquisitionReceipt.currency.remainingLabel}}</dd></div>
    <div><dt>{{localize "wayfinder-pf2e.AcquisitionReceipt.FundingSelectedBy"}}</dt><dd>{{acquisitionReceipt.authority.recipeSelectionLabel}}{{#if acquisitionReceipt.authority.recipeSelectedAt}} {{localize "wayfinder-pf2e.AcquisitionReceipt.At"}} <time datetime="{{acquisitionReceipt.authority.recipeSelectedAt}}">{{acquisitionReceipt.authority.recipeSelectedAt}}</time>{{/if}}</dd></div>
  </dl>

  {{#if acquisitionReceipt.itemRows.length}}
    <div class="acquisition-receipt-items" role="list" aria-label="{{localize "wayfinder-pf2e.AcquisitionReceipt.ItemsAria"}}">
      {{#each acquisitionReceipt.itemRows}}
        <article role="listitem">
          <span>
            <strong>{{name}}</strong>
            <small>{{fundingLabel}}{{#if containerName}} · {{localize "wayfinder-pf2e.AcquisitionReceipt.InContainer" containerName=containerName}}{{/if}}</small>
          </span>
          <span>×{{quantity}}</span>
        </article>
      {{/each}}
    </div>
  {{else}}
    <p class="acquisition-receipt-empty">{{localize "wayfinder-pf2e.AcquisitionReceipt.Empty"}}</p>
  {{/if}}

  {{#if acquisitionReceipt.classGrantRows.length}}
    <details>
      <summary>{{localize "wayfinder-pf2e.AcquisitionReceipt.ClassGrant.Summary"}}</summary>
      <ul>
        {{#each acquisitionReceipt.classGrantRows}}
          <li>{{statusLabel}} <code>{{grantId}}</code></li>
        {{/each}}
      </ul>
    </details>
  {{/if}}

  <footer>
    <span>{{acquisitionReceipt.authority.applyLabel}} · {{acquisitionReceipt.authority.recipeChoiceLabel}} · {{acquisitionReceipt.authority.higherLevelStartLabel}}</span>
    {{#if acquisitionReceipt.authority.judgmentIds.length}}
      <span>{{localize "wayfinder-pf2e.AcquisitionReceipt.Judgments"}}: {{#each acquisitionReceipt.authority.judgmentIds}}{{#unless @first}}, {{/unless}}<code>{{this}}</code>{{/each}}</span>
    {{/if}}
    <small>{{acquisitionReceipt.environmentLabel}}</small>
  </footer>
</section>

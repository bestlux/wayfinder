<section class="skill-training-stage class-choice-stage">
  <article class="skill-training-sheet class-choice-sheet" data-wayfinder-scroll-id="{{activePane.stepId}}:sheet">
    <header class="skill-training-header">
      <div>
        <p class="eyebrow">Languages</p>
        <h4>{{activePane.selectedCount}} / {{activePane.requiredCount}} chosen</h4>
        <p>{{activePane.description}}</p>
      </div>
      <div class="skill-training-status">
        <span class="skill-cap-label">Draft status</span>
        <strong>{{activePane.selectedLabel}}</strong>
      </div>
    </header>

    <section class="skill-training-block">
      <header class="skill-training-block-header">
        <div>
          <p class="eyebrow">{{activePane.sourceName}}</p>
          <h5>Granted automatically</h5>
        </div>
      </header>

      {{#if activePane.grantedLanguages.length}}
        <div class="skill-training-choice-list class-choice-list">
          {{#each activePane.grantedLanguages}}
            <div class="skill-training-choice class-choice-option selected">
              <span class="class-choice-copy">
                <span class="skill-training-choice-name">{{this}}</span>
              </span>
              <span class="skill-training-choice-action">Granted</span>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="context-note">This source doesn't grant any starting languages.</p>
      {{/if}}
    </section>

    <section class="skill-training-block">
      <header class="skill-training-block-header">
        <div>
          <p class="eyebrow">Choose additional languages</p>
          <h5>Available for {{activePane.sourceName}}</h5>
        </div>
      </header>

      {{#if activePane.sourceOptions.length}}
        <div class="skill-training-choice-list skill-training-choice-grid class-choice-list language-choice-grid">
          {{#each activePane.sourceOptions}}
            <button
              type="button"
              class="skill-training-choice skill-training-choice-option class-choice-option{{#if selected}} selected{{/if}}"
              data-wayfinder-action="toggle-language-choice"
              data-step-id="{{@root.activePane.stepId}}"
              data-value="{{value}}"
              aria-pressed="{{selected}}"
              title="{{label}}"
            >
              <span class="skill-training-choice-copy class-choice-copy">
                <span class="skill-training-choice-name">{{label}}</span>
              </span>
              <span class="skill-training-choice-action">{{#if selected}}Chosen{{else}}Choose{{/if}}</span>
            </button>
          {{/each}}
        </div>
      {{else}}
        <p class="context-note">This source doesn't offer any additional languages without GM approval.</p>
      {{/if}}

      {{#if activePane.approvalOptions.length}}
        <details class="language-approval-options"{{#if activePane.approvalOptionsOpen}} open{{/if}}>
          <summary>
            <span>Other languages ({{activePane.approvalOptionCount}})</span>
            <span class="language-approval-summary-note">GM approval required</span>
          </summary>
          <p class="context-note language-approval-note" id="{{activePane.stepId}}-gm-approval-note">
            Ask your GM before choosing one of these campaign languages.
          </p>
          <div class="skill-training-choice-list skill-training-choice-grid class-choice-list language-choice-grid">
            {{#each activePane.approvalOptions}}
              <button
                type="button"
                class="skill-training-choice skill-training-choice-option class-choice-option{{#if selected}} selected{{/if}}"
                data-wayfinder-action="toggle-language-choice"
                data-step-id="{{@root.activePane.stepId}}"
                data-value="{{value}}"
                aria-pressed="{{selected}}"
                aria-describedby="{{@root.activePane.stepId}}-gm-approval-note"
                title="{{label}}"
              >
                <span class="skill-training-choice-copy class-choice-copy">
                  <span class="skill-training-choice-name">{{label}}</span>
                </span>
                <span class="skill-training-choice-action">{{#if selected}}Chosen{{else}}Choose{{/if}}</span>
              </button>
            {{/each}}
          </div>
        </details>
      {{/if}}
    </section>
  </article>
</section>

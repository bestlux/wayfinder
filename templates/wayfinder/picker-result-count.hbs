<div class="browser-header-row" data-application-part="picker-count" data-step-id="{{activePane.stepId}}">
  {{#if (eq activePane.templateKind "spell-choice")}}
    <p class="picker-result-count" role="status" aria-live="polite" aria-atomic="true">{{activePane.resultCount}} matching spell{{#unless (eq activePane.resultCount 1)}}s{{/unless}}</p>
  {{else}}
    <p class="picker-result-count" role="status" aria-live="polite" aria-atomic="true">{{activePane.resultCount}} matching choice{{#unless (eq activePane.resultCount 1)}}s{{/unless}}</p>
  {{/if}}
  {{#if activePane.suppressionNotice}}
    {{#if activePane.suppressionNotice.unavailable}}
      <details class="picker-unavailable-choices" {{#if activePane.suppressionNotice.unavailable.expanded}}open{{/if}}>
        <summary>{{activePane.suppressionNotice.unavailable.summary}}</summary>
        <ul>
          {{#each activePane.suppressionNotice.unavailable.choices}}
            <li><strong>{{name}}</strong><p>{{reason}}</p></li>
          {{/each}}
        </ul>
        <p>{{activePane.suppressionNotice.message}}</p>
      </details>
    {{else}}
      <p class="picker-suppression-notice"><i class="fa-solid fa-eye-slash"></i> {{activePane.suppressionNotice.message}}</p>
    {{/if}}
  {{/if}}
</div>

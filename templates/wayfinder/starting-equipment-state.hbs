{{#if activePane.corrupt}}
  <section class="equipment-callout error" tabindex="-1" data-wayfinder-focus-id="starting-equipment-initialize">
    <i class="equipment-callout-mark fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
    <div class="equipment-callout-copy">
      <h4>{{localize "wayfinder-pf2e.StartingEquipment.Corrupt.Title"}}</h4>
      <p>{{localize "wayfinder-pf2e.StartingEquipment.Corrupt.Body"}}</p>
    </div>
  </section>
{{else}}
  {{#unless activePane.initialized}}
    <section class="equipment-callout equipment-gateway" tabindex="-1" data-wayfinder-focus-id="starting-equipment-initialize">
      <i class="equipment-callout-mark fa-solid fa-scale-balanced" aria-hidden="true"></i>
      <div class="equipment-callout-copy">
        <p class="eyebrow">{{localize "wayfinder-pf2e.StartingEquipment.Initialize.Eyebrow"}}</p>
        <h4>{{localize "wayfinder-pf2e.StartingEquipment.Initialize.Title"}}</h4>
        <p>{{localize "wayfinder-pf2e.StartingEquipment.Initialize.Body"}}</p>
        <button type="button" class="primary" data-wayfinder-action="initialize-starting-equipment" data-wayfinder-focus-id="starting-equipment-start" data-step-id="{{activePane.stepId}}">
          <i class="fa-solid fa-shop" aria-hidden="true"></i>{{localize "wayfinder-pf2e.StartingEquipment.Actions.StartShopping"}}
        </button>
      </div>
    </section>
  {{else}}
    {{#unless activePane.setup.awaitingAuthority}}
      {{#if activePane.handoff.active}}
        <section class="equipment-callout warning" tabindex="-1" data-wayfinder-focus-id="starting-equipment-handoff">
          <i class="equipment-callout-mark fa-solid fa-right-left" aria-hidden="true"></i>
          <div class="equipment-callout-copy">
            <h4>{{localize "wayfinder-pf2e.StartingEquipment.Handoff.Title"}}</h4>
            {{#each activePane.handoff.reasons}}<p>{{this}}</p>{{/each}}
            {{#unless activePane.handoff.acknowledged}}
              <button type="button" class="primary" data-wayfinder-action="acknowledge-equipment-handoff" data-wayfinder-focus-id="starting-equipment-acknowledge-handoff" data-step-id="{{activePane.stepId}}">{{localize "wayfinder-pf2e.StartingEquipment.Actions.GotIt"}}</button>
            {{else}}
              <p class="equipment-reviewed"><i class="fa-solid fa-circle-check" aria-hidden="true"></i>{{localize "wayfinder-pf2e.StartingEquipment.Handoff.Acknowledged"}}</p>
            {{/unless}}
          </div>
        </section>
      {{else}}
        {{#if activePane.titanMauler.required}}
          <section class="equipment-callout warning titan-mauler-callout" tabindex="-1" data-wayfinder-focus-id="starting-equipment-titan-mauler">
            <i class="equipment-callout-mark fa-solid fa-hand-fist" aria-hidden="true"></i>
            <div class="equipment-callout-copy">
              {{#if activePane.titanMauler.selected}}
                <h4>{{localize "wayfinder-pf2e.StartingEquipment.TitanMauler.SelectedTitle"}}</h4>
                <p>{{localize "wayfinder-pf2e.StartingEquipment.TitanMauler.SelectedBody" name=activePane.titanMauler.selectedName}}</p>
              {{else}}
                <h4>{{localize "wayfinder-pf2e.StartingEquipment.TitanMauler.ChooseTitle"}}</h4>
                <p>{{localize "wayfinder-pf2e.StartingEquipment.TitanMauler.ChooseBody"}}</p>
                <p class="equipment-callout-hint">{{localize "wayfinder-pf2e.StartingEquipment.TitanMauler.ChooseHint"}}</p>
              {{/if}}
            </div>
          </section>
        {{/if}}
      {{/if}}
    {{/unless}}
  {{/unless}}
{{/if}}

<div class="equipment-catalogue-projection" data-application-part="equipment-catalogue" data-step-id="{{activePane.stepId}}" data-wayfinder-rendered-query="{{activePane.catalogue.search}}" data-wayfinder-view-revision="{{equipmentRequest.viewRevision}}" data-wayfinder-source-revision="{{equipmentRequest.sourceRevision}}">
  <div class="equipment-filter-row" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.FiltersAria"}}" aria-controls="{{activePane.stepId}}-equipment-results">
    {{#each activePane.catalogue.typeFilters}}<button type="button" class="equipment-type-chip{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><i class="fa-solid {{icon}}" aria-hidden="true"></i><span>{{label}}</span></button>{{/each}}

    <span class="equipment-filter-divider" aria-hidden="true"></span>

    {{#if activePane.catalogue.rarityFilters.length}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.rarityFilterActive}} is-active{{/if}}{{#if activePane.catalogue.rarityPanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.rarityPanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-rarity-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:rarity" data-step-id="{{activePane.stepId}}" data-filter-key="rarity"><span>{{activePane.catalogue.rarityFilterLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
    {{#if activePane.catalogue.hasSourceFilters}}<button type="button" class="equipment-filter-trigger{{#if activePane.catalogue.sourceFilterActive}} is-active{{/if}}{{#if activePane.catalogue.sourcePanelOpen}} is-open{{/if}}" aria-expanded="{{#if activePane.catalogue.sourcePanelOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-equipment-source-filters" data-wayfinder-action="toggle-equipment-filter-panel" data-wayfinder-focus-id="starting-equipment-filter-panel:source" data-step-id="{{activePane.stepId}}" data-filter-key="source"><span>{{activePane.catalogue.sourceFilterLabel}}</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></button>{{/if}}
  </div>

  {{#if activePane.catalogue.rarityPanelOpen}}
    <div class="equipment-filter-panel" id="{{activePane.stepId}}-equipment-rarity-filters" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.RarityFiltersAria"}}">
      {{#each activePane.catalogue.rarityFilters}}<button type="button" class="equipment-filter-option rarity-{{value}}{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><span class="equipment-filter-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>{{label}}</button>{{/each}}
    </div>
  {{/if}}

  {{#if activePane.catalogue.sourcePanelOpen}}
    <div class="equipment-source-filter-panel" id="{{activePane.stepId}}-equipment-source-filters">
      <label class="search-shell compact">
        <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        <input type="search" value="{{activePane.catalogue.sourceSearch}}" placeholder="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchPlaceholder"}}" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceSearchAria"}}" aria-controls="{{activePane.stepId}}-equipment-source-options" data-wayfinder-equipment-source-search data-wayfinder-focus-id="starting-equipment-source-search" data-step-id="{{activePane.stepId}}" />
      </label>
      <p role="status" aria-live="polite" aria-atomic="true">{{activePane.catalogue.sourceResultAnnouncement}}</p>
      <div id="{{activePane.stepId}}-equipment-source-options" role="group" aria-label="{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.SourceFiltersAria"}}" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-source-filters">
        {{#each activePane.catalogue.sourceFilters}}<button type="button" class="equipment-filter-option{{#if selected}} is-selected{{/if}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-equipment-filter" data-wayfinder-focus-id="{{focusId}}" data-step-id="{{../activePane.stepId}}" data-filter-key="{{key}}" data-value="{{value}}"><span class="equipment-filter-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>{{label}}</button>{{/each}}
      </div>
    </div>
  {{/if}}

  <p class="equipment-result-count" role="status" aria-live="polite" aria-atomic="true">
    <span>{{activePane.catalogue.resultAnnouncement}}</span>
    {{#if activePane.catalogue.narrowSearchHint}}<small>{{activePane.catalogue.narrowSearchHint}}</small>{{/if}}
  </p>

  {{#unless activePane.catalogue.items.length}}
    <div class="equipment-catalogue-state {{activePane.catalogue.state}}" role="status" aria-live="polite" aria-atomic="true">
      <i class="fa-solid fa-box-open" aria-hidden="true"></i>
      <p>{{activePane.catalogue.message}}</p>
      {{#if activePane.catalogue.diagnostics.length}}
        <ul class="equipment-source-diagnostics">
          {{#each activePane.catalogue.diagnostics}}<li data-equipment-source-diagnostic="{{code}}"><strong>{{packId}}</strong>: {{message}}</li>{{/each}}
        </ul>
      {{/if}}
    </div>
  {{/unless}}

  <div class="equipment-result-list" id="{{activePane.stepId}}-equipment-results" data-wayfinder-scroll-id="{{activePane.stepId}}:equipment-results">
    {{#each activePane.catalogue.items}}
      <article class="equipment-result-row{{#if previewing}} is-previewing{{/if}}{{#unless canAdd}} is-blocked{{/unless}}">
        <button type="button" class="equipment-result" aria-label="{{previewAriaLabel}}" aria-pressed="{{#if previewing}}true{{else}}false{{/if}}" data-equipment-item data-source-uuid="{{sourceUuid}}" data-filter-rarity="{{rarity}}" data-filter-source="{{sourceLabel}}" data-filter-type="{{itemType}}" data-wayfinder-action="preview-equipment-item" data-wayfinder-focus-id="{{previewFocusId}}" data-step-id="{{../activePane.stepId}}">
          <span class="equipment-result-art"><i class="fa-solid {{typeIcon}}" aria-hidden="true"></i></span>
          <span class="equipment-result-copy">
            <span class="equipment-result-title">
              <span class="equipment-result-name">{{name}}</span>
              <span class="tag equipment-result-level">{{localize "wayfinder-pf2e.StartingEquipment.Catalogue.LevelTag" level=level}}</span>
              {{#unless (eq rarity "common")}}<span class="tag rarity-{{rarity}}">{{rarityLabel}}</span>{{/unless}}
            </span>
            <span class="equipment-result-meta">{{itemTypeLabel}} · {{sourceLabel}}{{#if unavailableReason}} · <span class="equipment-result-block">{{unavailableReason}}</span>{{/if}}</span>
          </span>
          <span class="equipment-result-price{{#unless canAdd}} is-unaffordable{{/unless}}">{{priceLabel}}</span>
        </button>
      </article>
    {{/each}}
  </div>
</div>

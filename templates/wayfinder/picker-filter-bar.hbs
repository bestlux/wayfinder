{{#if (or activePane.filterGroups.length activePane.traitFilter)}}
  <div class="picker-filter-bar">
    {{#each activePane.filterGroups}}
      <section class="picker-filter-menu{{#if isOpen}} is-open{{/if}}" data-wayfinder-filter-menu data-step-id="{{../activePane.stepId}}" data-filter-kind="{{key}}">
        <button type="button" class="picker-filter-trigger{{#if selectedCount}} is-active{{/if}}{{#if isOpen}} is-open{{/if}}" data-wayfinder-action="toggle-picker-filter-menu" data-step-id="{{../activePane.stepId}}" data-filter-kind="{{key}}" aria-expanded="{{#if isOpen}}true{{else}}false{{/if}}">
          <span class="picker-filter-trigger-copy">
            <span class="picker-filter-label">{{label}}</span>
            <span class="picker-filter-summary">{{summaryLabel}}</span>
          </span>

          <span class="picker-filter-trigger-meta">
            {{#if selectedCount}}
              <span class="picker-filter-badge">{{selectedCount}}</span>
            {{/if}}
            <i class="fa-solid fa-chevron-down"></i>
          </span>
        </button>

        {{#if isOpen}}
          <div class="picker-filter-panel">
            <div class="picker-filter-panel-header">
              <span class="picker-filter-panel-title">{{label}}</span>
              <span class="picker-filter-panel-summary">{{summaryLabel}}</span>
            </div>

            {{#if range}}
              <div class="picker-level-range" data-wayfinder-scroll-id="{{../activePane.stepId}}:filter:{{key}}">
                <div class="picker-level-range-bound">
                  <span class="picker-level-range-label">From</span>
                  <div class="picker-level-range-values">
                    {{#each values}}
                      <button type="button" class="picker-level-range-value{{#if minimumSelected}} is-selected{{/if}}" data-wayfinder-action="set-picker-level-range" data-step-id="{{../../activePane.stepId}}" data-minimum="{{minimumRangeStart}}" data-maximum="{{minimumRangeEnd}}" aria-pressed="{{#if minimumSelected}}true{{else}}false{{/if}}">{{label}}</button>
                    {{/each}}
                  </div>
                </div>

                <div class="picker-level-range-bound">
                  <span class="picker-level-range-label">Through</span>
                  <div class="picker-level-range-values">
                    {{#each values}}
                      <button type="button" class="picker-level-range-value{{#if maximumSelected}} is-selected{{/if}}" data-wayfinder-action="set-picker-level-range" data-step-id="{{../../activePane.stepId}}" data-minimum="{{maximumRangeStart}}" data-maximum="{{maximumRangeEnd}}" aria-pressed="{{#if maximumSelected}}true{{else}}false{{/if}}">{{label}}</button>
                    {{/each}}
                  </div>
                </div>
              </div>
            {{else}}
              <div class="picker-filter-options" data-wayfinder-scroll-id="{{../activePane.stepId}}:filter:{{key}}">
                {{#each options}}
                  <button type="button" class="picker-filter-option{{#if selected}} is-selected{{/if}}" data-wayfinder-action="toggle-picker-filter" data-step-id="{{../../activePane.stepId}}" data-filter-kind="{{../key}}" data-value="{{value}}">
                    <span class="picker-filter-check">{{#if selected}}<i class="fa-solid fa-check"></i>{{/if}}</span>
                    <span class="picker-filter-option-label">{{label}}</span>
                    <span class="picker-filter-count">{{count}}</span>
                  </button>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{/if}}
      </section>
    {{/each}}

    {{#if activePane.traitFilter}}
      <section class="picker-filter-menu picker-trait-menu{{#if activePane.traitFilter.isOpen}} is-open{{/if}}" data-wayfinder-filter-menu data-step-id="{{activePane.stepId}}" data-filter-kind="traits">
        <button type="button" class="picker-filter-trigger{{#if activePane.traitFilter.selectedCount}} is-active{{/if}}" data-wayfinder-action="toggle-picker-filter-menu" data-wayfinder-focus-id="picker-traits-trigger" data-step-id="{{activePane.stepId}}" data-filter-kind="traits" aria-expanded="{{#if activePane.traitFilter.isOpen}}true{{else}}false{{/if}}" aria-controls="{{activePane.stepId}}-trait-panel">
          <span class="picker-filter-trigger-copy"><span class="picker-filter-label">{{localize "wayfinder-pf2e.FeatTraits.Label"}}</span><span class="picker-filter-summary" title="{{activePane.traitFilter.summary}}">{{#if activePane.traitFilter.selectedCount}}{{activePane.traitFilter.summary}}{{else}}{{localize "wayfinder-pf2e.FeatTraits.All"}}{{/if}}</span></span>
          <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
        </button>
        {{#if activePane.traitFilter.isOpen}}
          <div class="picker-filter-panel picker-trait-panel" id="{{activePane.stepId}}-trait-panel" data-picker-trait-panel>
            <p class="picker-trait-help">{{localize "wayfinder-pf2e.FeatTraits.Help"}}</p>
            <label class="search-shell compact"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input type="search" data-picker-trait-search data-step-id="{{activePane.stepId}}" aria-label="{{localize "wayfinder-pf2e.FeatTraits.Search"}}" placeholder="{{localize "wayfinder-pf2e.FeatTraits.Search"}}" /></label>
            <p class="picker-trait-help" role="status" aria-live="polite" aria-atomic="true"><span data-picker-trait-count>{{activePane.traitFilter.options.length}}</span> {{localize "wayfinder-pf2e.FeatTraits.Shown"}}</p>
            <div class="picker-filter-options" data-wayfinder-scroll-id="{{activePane.stepId}}:filter:traits">
              {{#each activePane.traitFilter.options}}
                <div class="picker-trait-option" data-picker-trait-option data-search="{{label}} {{value}}" data-active="{{#if active}}true{{else}}false{{/if}}" role="group" aria-label="{{label}}">
                  <span class="picker-trait-label">{{label}} <span class="picker-filter-count" title="{{localize "wayfinder-pf2e.FeatTraits.CountHint"}}">{{count}}</span></span>
                  <button type="button" aria-label="{{localize "wayfinder-pf2e.FeatTraits.Include"}} {{label}}" aria-pressed="{{#if included}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-picker-trait" data-wayfinder-focus-id="picker-trait-include:{{value}}" data-step-id="{{../activePane.stepId}}" data-value="{{value}}" data-mode="include">{{localize "wayfinder-pf2e.FeatTraits.Include"}}</button>
                  <button type="button" aria-label="{{localize "wayfinder-pf2e.FeatTraits.Exclude"}} {{label}}" aria-pressed="{{#if excluded}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-picker-trait" data-wayfinder-focus-id="picker-trait-exclude:{{value}}" data-step-id="{{../activePane.stepId}}" data-value="{{value}}" data-mode="exclude">{{localize "wayfinder-pf2e.FeatTraits.Exclude"}}</button>
                </div>
              {{/each}}
            </div>
          </div>
        {{/if}}
      </section>
      {{#if activePane.traitFilter.canHideDedications}}
        <button type="button" class="secondary compact picker-dedication-shortcut" aria-pressed="{{#if activePane.traitFilter.hideDedications}}true{{else}}false{{/if}}" data-wayfinder-action="toggle-picker-trait" data-wayfinder-focus-id="picker-traits-dedication" data-step-id="{{activePane.stepId}}" data-value="dedication" data-mode="exclude">{{localize "wayfinder-pf2e.FeatTraits.HideDedications"}}</button>
      {{/if}}
    {{/if}}

    {{#if activePane.activeFilterCount}}
      <button type="button" class="secondary compact picker-filter-clear" data-wayfinder-action="clear-picker-filters" data-step-id="{{activePane.stepId}}">
        Clear filters
      </button>
    {{/if}}
  </div>
{{/if}}
